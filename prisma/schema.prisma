generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AuthorizedService {
    id Int @id @default(autoincrement())
    name String @unique
    api_key String @unique @db.VarChar(64)

    can_tokenize Boolean @default(true)
    can_fetch Boolean @default(false)
    can_manage Boolean @default(false)

    is_active Boolean @default(true)
    created_at DateTime @default(now())
    
    tokens PaymentToken[]
    @@map("authorized_services")
}


model Card {
    id Int @id @default(autoincrement())
    fingerprint String @unique
    encrypted_data Bytes @db.ByteA
    card_holder_name String @db.VarChar(100)
    last_four_digits String @db.Char(4)
    expiration_date String @db.Char(5)
    type String
    is_active Boolean @default(true)
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    tokens PaymentToken[]
    @@map("cards")
}

model PaymentToken {
    id Int @id @default(autoincrement())
    token String @unique
    card_id Int 
    service_id Int
    is_active Boolean @default(true)
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    card Card @relation(fields: [card_id], references: [id])
    service AuthorizedService @relation(fields: [service_id], references: [id])
    @@map("payment_tokens")
}
